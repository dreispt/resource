        <field name="global" eval="True" />
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_rotation_application_company" model="ir.rule">
        <field name="name">Rotation application multi company rule</field>
        <field name="model_id" ref="model_resource_rotation_application" />
        <field name="global" eval="True" />
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
