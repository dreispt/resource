<odoo>
    <record id="resource_rotation_plan_form" model="ir.ui.view">
        <field name="name">resource.service.rotation.form</field>
        <field name="model">resource.rotation.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_cells"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-th"
                        >
                            <field name="cell_count" string="Cells" />
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. 4-on / 4-off" />
                        </h1>
                    </div>
                    <group name="main">
                        <group name="general" string="General">
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="tag_ids" widget="many2many_tags" />
                            <field name="cycle_days" />
                            <field name="color" widget="color_picker" />
                        </group>
                    </group>
                    <notebook>
                        <page name="rows" string="Resource Codes">
                            <field name="crew_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="code" placeholder="A" />
                                </list>
                            </field>
                        </page>
                        <page name="matrix" string="Matrix">
                            <field name="cell_ids">
                                <list editable="bottom">
                                    <field name="crew_id" />
                                    <field name="day" />
                                    <field name="period_id" />
                                    <field name="period_code" />
                                    <field name="is_day_off" />
                                </list>
                            </field>
                        </page>
                        <page name="notes" string="Notes">
                            <field name="description" nolabel="1" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="resource_rotation_plan_list" model="ir.ui.view">
        <field name="name">resource.service.rotation.list</field>
        <field name="model">resource.rotation.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="tag_ids" widget="many2many_tags" />
                <field name="cycle_days" />
                <field name="crew_count" />
            </list>
        </field>
    </record>

    <record id="resource_rotation_plan_search" model="ir.ui.view">
        <field name="name">resource.service.rotation.search</field>
        <field name="model">resource.rotation.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <group>
                    <field name="tag_ids" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_resource_rotation_plan" model="ir.actions.act_window">
        <field name="name">Rotation Plans</field>
        <field name="res_model">resource.rotation.plan</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="resource_rotation_plan_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first rotation plan
            </p>
            <p>
                A rotation is a reusable work/rest cycle, such as
                4-on / 4-off, assigned to positions.
            </p>
        </field>
    </record>
    <record id="resource_rotation_application_list" model="ir.ui.view">
        <field name="name">resource.rotation.application.list</field>
        <field name="model">resource.rotation.application</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="rotation_id" />
                <field name="resource_id" />
                <field name="start_date" />
                <field name="end_date" />
                <field name="days_offset" />
                <field name="notes" />
            </list>
        </field>
    </record>

    <record id="resource_rotation_cell_list" model="ir.ui.view">
        <field name="name">resource.rotation.cell.list</field>
        <field name="model">resource.rotation.cell</field>
        <field name="arch" type="xml">
            <list>
                <field name="crew_id" />
                <field name="day" />
                <field name="period_id" />
                <field name="period_code" />
                <field name="is_day_off" />
            </list>
        </field>
    </record>

    <record id="resource_rotation_cell_pivot" model="ir.ui.view">
        <field name="name">resource.rotation.cell.pivot</field>
        <field name="model">resource.rotation.cell</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="crew_id" type="row" />
                <field name="period_id" type="col" />
            </pivot>
        </field>
    </record>
</odoo>
