<odoo>
    <record id="category_resource_reservation" model="ir.module.category">
        <field name="name">Resource Reservation</field>
    </record>
    <record id="privilege_resource_reservation" model="res.groups.privilege">
        <field name="name">Resource Reservation</field>
        <field name="category_id" ref="category_resource_reservation" />
    </record>
    <record id="group_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_resource_reservation" />
        <field name="comment">Users allowed to manage reservations</field>
    </record>
    <record id="group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_resource_reservation" />
        <field name="implied_ids" eval="[(4, ref('group_user'))]" />
        <field
            name="comment"
        >Users allowed to configure types, categories and resources.</field>
        <field
            name="user_ids"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
    </record>
    <data noupdate="1">
        <record id="rule_reservation_type_company" model="ir.rule">
            <field name="name">Reservation type multi company rule</field>
            <field name="model_id" ref="model_resource_reservation_type" />
            <field name="global" eval="True" />
            <field
                name="domain_force"
            >[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="rule_reservation_company" model="ir.rule">
            <field name="name">Reservation multi company rule</field>
            <field name="model_id" ref="model_resource_reservation" />
            <field name="global" eval="True" />
            <field
                name="domain_force"
            >[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="rule_reservation_portal" model="ir.rule">
            <field name="name">Reservation portal rule</field>
            <field name="model_id" ref="model_resource_reservation" />
            <field name="groups" eval="[(4, ref('base.group_portal'))]" />
            <field
                name="domain_force"
            >['|', ('partner_id', 'child_of', user.partner_id.ids), ('message_partner_ids', 'child_of', user.partner_id.ids)]</field>
        </record>
        <record id="rule_reservation_user" model="ir.rule">
            <field name="name">Reservation user rule</field>
            <field name="model_id" ref="model_resource_reservation" />
            <field name="groups" eval="[(4, ref('group_user'))]" />
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
    </data>
</odoo>
