<odoo>
    <record id="resource_resource_form" model="ir.ui.view">
        <field name="name">resource.resource.form.service.planning</field>
        <field name="model">resource.resource</field>
        <field name="inherit_id" ref="resource.resource_resource_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='time_efficiency']" position="after" />
            <xpath expr="//sheet" position="inside">
                <div class="oe_button_box" name="button_box">
                    <button
                        name="action_view_service_assignments"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-calendar-check-o"
                        groups="resource_planning.group_user"
                    >
                        <field name="service_assignment_count" string="Assignments" />
                    </button>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
