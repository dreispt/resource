<odoo>
    <record id="resource_period_form" model="ir.ui.view">
        <field name="name">resource.period.form</field>
        <field name="model">resource.planning.period</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group name="main">
                        <field name="name" placeholder="e.g. Night" />
                        <field name="code" placeholder="e.g. N" />
                        <field name="sequence" />
                        <field name="color" widget="color_picker" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="resource_period_list" model="ir.ui.view">
        <field name="name">resource.period.list</field>
        <field name="model">resource.planning.period</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="code" />
                <field name="is_day_off" />
            </list>
        </field>
    </record>

    <record id="action_resource_planning_period" model="ir.actions.act_window">
        <field name="name">Day Periods</field>
        <field name="res_model">resource.planning.period</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
