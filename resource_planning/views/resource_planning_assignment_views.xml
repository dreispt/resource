<odoo>
    <record id="resource_assignment_form" model="ir.ui.view">
        <field name="name">resource.assignment.form</field>
        <field name="model">resource.planning.assignment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_plan"
                        type="object"
                        string="Plan"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_publish"
                        type="object"
                        string="Publish"
                        class="btn-primary"
                        invisible="state not in ('draft', 'planned')"
                    />
                    <button
                        name="action_complete"
                        type="object"
                        string="Complete"
                        invisible="state != 'published'"
                    />
                    <button
                        name="action_draft"
                        type="object"
                        string="Set to Draft"
                        invisible="state not in ('planned', 'cancelled')"
                    />
                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        invisible="state in ('completed', 'cancelled')"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,planned,published,completed"
                    />
                </header>
                <sheet>
                    <div
                        class="alert alert-warning"
                        role="alert"
                        invisible="not warning_message"
                    >
                        <field name="warning_message" readonly="1" />
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field
                                name="name"
                                placeholder="e.g. Van 2 on the night route"
                            />
                        </h1>
                    </div>
                    <group name="main">
                        <group name="general" string="General">
                            <field name="resource_id" />
                            <field name="role_id" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                        <group name="timing" string="Interval">
                            <field name="start_datetime" />
                            <field name="end_datetime" />
                        </group>
                    </group>
                    <group
                        name="conflicts"
                        string="Conflicts"
                        invisible="not has_conflicts"
                    >
                        <field name="conflict_ids" nolabel="1">
                            <list>
                                <field name="resource_id" />
                                <field name="start_datetime" />
                                <field name="end_datetime" />
                                <field name="state" widget="badge" />
                            </list>
                        </field>
                    </group>
                    <group name="notes" string="Notes">
                        <field name="notes" nolabel="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="resource_assignment_list" model="ir.ui.view">
        <field name="name">resource.assignment.list</field>
        <field name="model">resource.planning.assignment</field>
        <field name="arch" type="xml">
            <list decoration-danger="has_conflicts">
                <field name="name" />
                <field name="resource_id" />
                <field name="role_id" />
                <field name="start_datetime" />
                <field name="end_datetime" />
                <field name="state" widget="badge" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="resource_assignment_calendar" model="ir.ui.view">
        <field name="name">resource.assignment.calendar</field>
        <field name="model">resource.planning.assignment</field>
        <field name="arch" type="xml">
            <calendar
                date_start="start_datetime"
                date_stop="end_datetime"
                color="resource_id"
                mode="week"
                event_open_popup="1"
            >
                <field name="name" />
            </calendar>
        </field>
    </record>

    <record id="resource_assignment_search" model="ir.ui.view">
        <field name="name">resource.assignment.search</field>
        <field name="model">resource.planning.assignment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="resource_id" />
                <filter
                    name="upcoming"
                    string="Upcoming"
                    domain="[('start_datetime', '&gt;=', context_today().strftime('%Y-%m-%d'))]"
                />
                <group>
                    <filter
                        name="group_resource"
                        string="Resource"
                        context="{'group_by': 'resource_id'}"
                    />
                    <filter
                        name="group_state"
                        string="State"
                        context="{'group_by': 'state'}"
                    />
                    <filter
                        name="group_start"
                        string="Start"
                        context="{'group_by': 'start_datetime:day'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_resource_planning_assignment" model="ir.actions.act_window">
        <field name="name">Assignments</field>
        <field name="res_model">resource.planning.assignment</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="search_view_id" ref="resource_assignment_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Assign your first resource
            </p>
            <p>
                An assignment allocates a generic resource to a time
                interval — ad hoc, or linked to demand when the
                demand addon is installed.
            </p>
        </field>
    </record>
</odoo>
